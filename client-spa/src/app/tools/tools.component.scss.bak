.tools-container {
  padding: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.tools-header {
  text-align: center;
  margin-bottom: 40px;

  h1 {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 10px;
  }

  p {
    font-size: 1.1rem;
    color: #666;
  }
}

.tools-content {
  display: flex;
  gap: 30px;
  margin-top: 30px;
}

.tools-sidebar {
  flex: 0 0 200px;
  background-color: #f5f5f5;
  border-radius: 8px;
  padding: 20px 0;
  height: fit-content;
  position: sticky;
  top: 70px;
}

.tools-menu {
  list-style: none;
  padding: 0;
  margin: 0;

  ul {
    list-style: none;
    padding: 0;
    margin: 0;

    li {
      margin: 0;
      padding: 0;
    }
  }

  .tool-link {
    display: block;
    padding: 12px 20px;
    color: #333;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border-left: 3px solid transparent;

    &:hover {
      background-color: #efefef;
      padding-left: 25px;
    }

    &.active {
      background-color: #e9913f;
      color: #fff;
      border-left-color: #d97b2f;
      font-weight: bold;
      padding-left: 25px;
    }
  }
}

.tools-main {
  flex: 1;
  min-height: 400px;
}

.tool-panel {
  animation: fadeIn 0.3s ease-in;

  h2 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 15px;
    border-bottom: 2px solid var(--color-orange-title);
    padding-bottom: 10px;
  }

  p {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 20px;
  }
}



.btn-primary {
  background-color: var(--color-orange-title);
  color: #fff;
  padding: 12px 30px;
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(233, 145, 63, 0.3);

  &:hover {
    background-color: #d97b2f;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(233, 145, 63, 0.4);
  }

  &:active {
    transform: translateY(0);
  }
}

.tool-placeholder {
  margin-top: 24px;
  padding: 20px;
  background: #fffbe6;
  border-radius: 8px;
  border: 1px solid #ffe0b2;

  h3 {
    margin-bottom: 12px;
    color: #e9913f;
  }

  .coming-soon {
    color: #d97b2f;
    font-weight: bold;
  }
}

// Document Converter Styles
.converter-container {
  margin-top: 30px;
}

.drop-zone {
  border: 3px dashed #e0e0e0;
  border-radius: 12px;
  padding: 60px 40px;
  text-align: center;
  background: #fafafa;
  transition: all 0.3s;
  cursor: pointer;

  &:hover, &.drag-over {
    border-color: #e9913f;
    background: #fff5ee;
  }

  &.drag-over {
    transform: scale(1.02);
  }

    .drop-zone-content {
      .upload-icon {
        font-size: 64px;
        display: block;
        margin-bottom: 20px;
      }

      h3 {
        margin: 0 0 15px;
        color: #333;
        font-size: 20px;
      }

      p {
        margin: 10px 0;
        color: #666;
      }

      .btn-upload {
        display: inline-block;
        padding: 12px 32px;
        background: linear-gradient(135deg, #e9913f 0%, #d67d2f 100%);
        color: white;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        margin: 10px 0;

        &:hover {
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba(233, 145, 63, 0.4);
        }
      }

      small {
        display: block;
        margin-top: 15px;
        color: #999;
        font-size: 13px;
      }
    }
  }

.file-preview {
  background: white;
  border: 2px solid #e0e0e0;
  border-radius: 12px;
  padding: 30px;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 25px;
  padding-bottom: 20px;
  border-bottom: 1px solid #f0f0f0;

  .file-icon {
    font-size: 48px;
  }

  .file-details {
    flex: 1;

    h4 {
      margin: 0 0 5px;
      color: #333;
      font-size: 18px;
      word-break: break-all;
    }

    p {
      margin: 0;
      color: #999;
      font-size: 14px;
    }
  }

  .btn-remove {
    background: #ffebee;
    border: none;
    color: #d32f2f;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;

    &:hover:not(:disabled) {
      background: #d32f2f;
      color: white;
      transform: scale(1.1);
    }

    &:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }
}

.btn-convert {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #e9913f 0%, #d67d2f 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 18px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s;

  &:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(233, 145, 63, 0.4);
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

// RTL Support
[dir='rtl'] {
  .tools-sidebar {
    margin-right: 0;
  }

  .tool-link {
    border-left: none;
    border-right: 3px solid transparent;

    &:hover {
      padding-left: 20px;
      padding-right: 25px;
    }

    &.active {
      border-left: none;
      border-right-color: #d97b2f;
      padding-left: 20px;
      padding-right: 25px;
    }
  }

  .tool-feature {
    border-left: none;
    border-right: 4px solid var(--color-orange-title);
  }
}

// Responsive Design
@media (max-width: 768px) {
  .tools-content {
    flex-direction: column;
    gap: 20px;
  }

  .tools-sidebar {
    flex: 0 0 auto;
    position: static;
  }

  .tools-header {
    h1 {
      font-size: 1.8rem;
    }

    p {
      font-size: 0.95rem;
    }
  }

  .tool-panel {
    h2 {
      font-size: 1.5rem;
    }
  }

  .btn-primary {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .tools-container {
    padding: 10px;
  }

  .tools-header {
    margin-bottom: 20px;

    h1 {
      font-size: 1.4rem;
    }

    p {
      font-size: 0.85rem;
    }
  }

  .tools-sidebar {
    padding: 10px 0;
  }

  .tool-link {
    padding: 10px 15px;
    font-size: 0.9rem;

    &:hover,
    &.active {
      padding-left: 20px;
    }
  }

  .tool-panel {
    h2 {
      font-size: 1.2rem;
    }

    p {
      font-size: 0.9rem;
    }
  }



  .btn-primary {
    padding: 10px 20px;
    font-size: 0.9rem;
  }
}

// JSON Formatter Styles
.json-formatter-container {
  margin-top: 20px;
}

.json-section {
  margin-bottom: 20px;

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;

    h3 {
      margin: 0;
      font-size: 1.2rem;
      color: #333;
    }

    .success-badge {
      background-color: #4caf50;
      color: white;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 0.85rem;
      font-weight: 500;
    }
  }
}

.json-textarea {
  width: 100%;
  padding: 15px;
  border: 2px solid #ddd;
  border-radius: 8px;
  font-family: 'Courier New', monospace;
  font-size: 14px;
  line-height: 1.5;
  resize: vertical;
  transition: border-color 0.3s;

  &:focus {
    outline: none;
    border-color: #007bff;
  }

  &.invalid {
    border-color: #f44336;
  }

  &.output {
    background-color: #f9f9f9;
    cursor: text;
  }

  &::placeholder {
    color: #999;
  }
}

.json-actions {
  display: flex;
  gap: 10px;
  margin: 20px 0;
  flex-wrap: wrap;
}

.btn-action {
  flex: 1;
  min-width: 120px;
  padding: 12px 20px;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  .icon {
    font-size: 1.2rem;
  }

  &:hover:not(:disabled) {
    background-color: #0056b3;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);
  }

  &:active:not(:disabled) {
    transform: translateY(0);
  }

  &:disabled {
    background-color: #ccc;
    cursor: not-allowed;
    opacity: 0.6;
  }
}

.btn-secondary {
  padding: 6px 16px;
  background-color: #6c757d;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background-color 0.3s;

  &:hover {
    background-color: #5a6268;
  }
}

.error-message {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  padding: 12px;
  background-color: #ffebee;
  border-left: 4px solid #f44336;
  border-radius: 4px;
  color: #c62828;
  font-size: 0.9rem;

  .error-icon {
    font-size: 1.2rem;
  }
}

@media (max-width: 768px) {
  .json-actions {
    flex-direction: column;

    .btn-action {
      width: 100%;
      min-width: auto;
    }
  }
}

// Text Tools Styles
.text-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 8px;
  margin: 12px 0;
  padding: 12px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 6px;
  box-shadow: 0 3px 10px rgba(102, 126, 234, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 8px;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.2);

  .stat-label {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2px;
  }

  .stat-value {
    font-size: 1rem;
    font-weight: 700;
    color: white;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }
}

.text-section {
  margin: 30px 0;

  h3 {
    margin-bottom: 15px;
    font-size: 1.2rem;
    color: #333;
    padding-left: 10px;
    border-left: 4px solid #007bff;
  }
}

@media (max-width: 768px) {
  .text-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 15px;
  }

  .stat-item {
    padding: 10px;

    .stat-label {
      font-size: 0.75rem;
    }

    .stat-value {
      font-size: 1.4rem;
    }
  }
}

@media (max-width: 480px) {
  .text-stats {
    grid-template-columns: 1fr;
  }
}

// Image Converter Styles
.image-preview-container {
  text-align: center;
  margin-bottom: 20px;
  padding: 20px;
  background: #f5f5f5;
  border-radius: 8px;

  .image-preview {
    max-width: 100%;
    max-height: 400px;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
}

.format-selector {
  display: flex;
  align-items: center;
  gap: 15px;
  margin: 20px 0;
  padding: 15px;
  background: #f8f9fa;
  border-radius: 8px;

  label {
    font-weight: 600;
    color: #333;
    min-width: 90px;
  }

  .format-select {
    flex: 1;
    padding: 10px 15px;
    border: 2px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    background: white;
    cursor: pointer;
    transition: border-color 0.3s;

    &:focus {
      outline: none;
      border-color: #007bff;
    }
  }
}

@media (max-width: 768px) {
  .image-preview-container {
    padding: 15px;

    .image-preview {
      max-height: 300px;
    }
  }

  .format-selector {
    flex-direction: column;
    align-items: stretch;

    label {
      min-width: auto;
    }

    .format-select {
      width: 100%;
    }
  }
}

// Lorem Ipsum Generator Styles
.lorem-controls {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.lorem-input-group {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 15px;
  background: #f8f9fa;
  border-radius: 8px;
  flex-wrap: wrap;

  label {
    font-weight: 600;
    color: #333;
    min-width: 90px;
  }

  .lorem-input {
    width: 100px;
    padding: 8px 12px;
    border: 2px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    transition: border-color 0.3s;

    &:focus {
      outline: none;
      border-color: #007bff;
    }
  }

  .btn-action {
    flex: 1;
    min-width: 180px;
  }
}

// GUID Generator Styles
.guid-container {
  background: #fff;
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.guid-settings {
  background: #f8f9fa;
  padding: 25px;
  border-radius: 8px;
  margin-bottom: 30px;

  h3 {
    font-size: 1.4rem;
    color: #333;
    margin-bottom: 20px;
  }

  .setting-group {
    margin-bottom: 20px;

    label {
      display: block;
      font-weight: 600;
      color: #333;
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    &.checkbox-group {
      label {
        display: flex;
        align-items: center;
        cursor: pointer;
        user-select: none;

        input {
          margin-right: 8px;
        }
      }
    }
  }

  .guid-input, .guid-select {
    width: 100%;
    padding: 10px 15px;
    border: 2px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    transition: all 0.3s ease;

    &:focus {
      outline: none;
      border-color: #e9913f;
      box-shadow: 0 0 0 3px rgba(233, 145, 63, 0.1);
    }
  }

  .guid-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .btn-generate {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, #e9913f 0%, #d97b2f 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 10px;

    .icon {
      margin-right: 8px;
    }

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(233, 145, 63, 0.4);
    }

    &:active {
      transform: translateY(0);
    }
  }
}

.guid-results {
  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid #e9913f;

    h3 {
      font-size: 1.3rem;
      color: #333;
      margin: 0;
    }

    .results-actions {
      display: flex;
      gap: 10px;
    }

    .btn-copy-all, .btn-clear {
      padding: 8px 16px;
      border: none;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;

      .icon {
        margin-right: 5px;
      }
    }

    .btn-copy-all {
      background: #007bff;
      color: white;

      &:hover {
        background: #0056b3;
      }
    }

    .btn-clear {
      background: #dc3545;
      color: white;

      &:hover {
        background: #bd2130;
      }
    }
  }
}

.guid-list {
  max-height: 500px;
  overflow-y: auto;
  padding: 10px;
  background: #f8f9fa;
  border-radius: 8px;

  .guid-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 15px;
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    margin-bottom: 10px;
    transition: all 0.2s ease;

    &:hover {
      border-color: #e9913f;
      box-shadow: 0 2px 8px rgba(233, 145, 63, 0.15);
    }

    .guid-value {
      font-family: 'Courier New', monospace;
      font-size: 0.95rem;
      color: #333;
      background: #f8f9fa;
      padding: 8px 12px;
      border-radius: 4px;
      flex: 1;
      margin-right: 10px;
    }

    .btn-copy-single {
      padding: 8px 12px;
      background: #28a745;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 1rem;

      &:hover {
        background: #218838;
        transform: scale(1.05);
      }

      &:active {
        transform: scale(0.95);
      }
    }
  }
}

.guid-info {
  padding: 30px;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 8px;
  text-align: center;

  .info-box {
    max-width: 600px;
    margin: 0 auto;

    h3 {
      font-size: 1.5rem;
      color: #333;
      margin-bottom: 15px;
    }

    p {
      font-size: 1rem;
      color: #666;
      line-height: 1.6;
      margin-bottom: 15px;
    }

    ul {
      text-align: left;
      list-style: none;
      padding: 0;
      margin-top: 20px;

      li {
        padding: 10px 15px;
        margin-bottom: 8px;
        background: white;
        border-left: 3px solid #e9913f;
        border-radius: 4px;
        color: #555;

        code {
          background: #f8f9fa;
          padding: 2px 6px;
          border-radius: 3px;
          font-family: 'Courier New', monospace;
          font-size: 0.9rem;
          color: #d97b2f;
        }
      }
    }
  }
}

@media (max-width: 768px) {
  .lorem-input-group {
    flex-direction: column;
    align-items: stretch;

    label {
      min-width: auto;
    }

    .lorem-input {
      width: 100%;
    }

    .btn-action {
      width: 100%;
      min-width: auto;
    }
  }

  .guid-container {
    padding: 20px;
  }

  .guid-settings {
    padding: 20px;
  }

  .guid-results {
    .results-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;

      .results-actions {
        width: 100%;
        
        button {
          flex: 1;
        }
      }
    }
  }

  .guid-item {
    flex-direction: column;
    align-items: stretch !important;

    .guid-value {
      margin-right: 0 !important;
      margin-bottom: 10px;
      word-break: break-all;
    }

    .btn-copy-single {
      width: 100%;
    }
  }

  .guid-converter-section {
    .converter-input-group {
      flex-direction: column;
    }

    .guid-converter-input {
      width: 100%;
    }

    .converter-buttons {
      width: 100%;
      flex-direction: column;

      button {
        width: 100%;
      }
    }

    .parsed-item {
      flex-direction: column;
      align-items: flex-start;

      .parsed-label {
        min-width: auto;
        margin-bottom: 5px;
      }

      .parsed-value {
        word-break: break-all;
      }
    }
  }
}

// GUID Converter Section Styles
.guid-converter-section {
  background: #f8f9fa;
  padding: 25px;
  border-radius: 8px;
  margin-bottom: 30px;

  &.top-section {
    margin-top: 0;
    padding-top: 25px;
    border-top: none;
  }

  h3 {
    font-size: 1.4rem;
    color: #333;
    margin-bottom: 8px;
  }

  p {
    color: #666;
    margin-bottom: 20px;
  }

  .converter-input-group {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
  }

  .guid-converter-input {
    flex: 1;
    padding: 12px 15px;
    border: 2px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    font-family: 'Courier New', monospace;
    transition: all 0.3s ease;

    &:focus {
      outline: none;
      border-color: #e9913f;
      box-shadow: 0 0 0 3px rgba(233, 145, 63, 0.1);
    }

    &::placeholder {
      font-family: Arial, sans-serif;
      color: #999;
    }
  }

  .converter-buttons {
    display: flex;
    gap: 8px;
  }

  .btn-convert-guid, .btn-clear-converter {
    padding: 12px 20px;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;

    .icon {
      margin-right: 5px;
    }
  }

  .btn-convert-guid {
    background: linear-gradient(135deg, #e9913f 0%, #d97b2f 100%);
    color: white;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(233, 145, 63, 0.4);
    }
  }

  .btn-clear-converter {
    background: #6c757d;
    color: white;

    &:hover {
      background: #5a6268;
    }
  }

  .error-message {
    background: #fff3cd;
    border: 1px solid #ffc107;
    color: #856404;
    padding: 10px 15px;
    border-radius: 6px;
    margin-bottom: 15px;

    .error-icon {
      margin-right: 8px;
    }
  }
}

.parsed-results {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 20px;
  margin-top: 20px;

  .parsed-item {
    display: flex;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #e0e0e0;

    &:last-child {
      border-bottom: none;
    }

    .parsed-label {
      min-width: 140px;
      font-weight: 600;
      color: #333;
      font-size: 0.95rem;
    }

    .parsed-value-group {
      display: flex;
      align-items: center;
      flex: 1;
      gap: 10px;
    }

    .parsed-value {
      flex: 1;
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
      background: white;
      padding: 8px 12px;
      border-radius: 4px;
      border: 1px solid #e0e0e0;
      color: #333;
      word-break: break-all;
    }

    .btn-copy-parsed {
      padding: 8px 12px;
      background: #28a745;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.9rem;

      &:hover {
        background: #218838;
        transform: scale(1.05);
      }

      &:active {
        transform: scale(0.95);
      }
    }
  }
}

